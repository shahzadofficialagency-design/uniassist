# ---- UniAssist environment (copy to .env, never commit real secrets) ----
ENVIRONMENT=dev
# SQLite for dev; PostgreSQL example: postgresql+psycopg2://user:pass@localhost:5432/uniassist
DATABASE_URL=sqlite:///./uniassist.db
JWT_SECRET=change-this-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# LLM (optional — system works fully with 'none'; LLM only rephrases verified facts)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
